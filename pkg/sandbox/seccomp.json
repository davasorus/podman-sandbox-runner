      "names": [
        "ptrace",
        "mount",
        "umount2",
        "pivot_root",
        "reboot",
        "kexec_load",
        "kexec_file_load",
        "init_module",
        "finit_module",
        "delete_module",
        "bpf",
        "perf_event_open",
        "acct",
        "swapon",
        "swapoff",
        "clock_settime",
        "settimeofday",
        "add_key",
        "request_key",
        "keyctl",
        "mknod",
        "mknodat"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}